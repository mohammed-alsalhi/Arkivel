# Required in wiki mode
DATABASE_URL="postgresql://user:password@host:5432/database"
ADMIN_SECRET="replace-me"

# `wiki` runs the knowledge base; `product` runs the public Arkivel site/docs.
ARKIVEL_SITE_MODE="wiki"
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Optional public branding
NEXT_PUBLIC_ARKIVEL_NAME="Arkivel"
NEXT_PUBLIC_ARKIVEL_DESCRIPTION="an open-source, self-hosted knowledge base"
NEXT_PUBLIC_ARKIVEL_WELCOME_TEXT="write, link, and search your documentation"
NEXT_PUBLIC_ARKIVEL_LOGO="/brand/arkivel-logo.png"
NEXT_PUBLIC_ARKIVEL_LOGO_MARK="/brand/arkivel-logo.svg"
NEXT_PUBLIC_ARKIVEL_APP_ICON="/brand/arkivel-icon-512.png"

# Optional file uploads
BLOB_READ_WRITE_TOKEN=""

# Optional OAuth
GITHUB_ID=""
GITHUB_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
NEXTAUTH_SECRET=""
